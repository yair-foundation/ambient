+import { render, screen, waitFor } from "@testing-library/react"
+import userEvent from "@testing-library/user-event"
+import { describe, expect, it, vi } from "vitest"
+
+import { UndoNotice } from "./undo-notice"
+
+describe("UndoNotice", () => {
+  it("announces what changed and its consequence politely", () => {
+    render(<UndoNotice message="Fernhill Capital qualified." detail="11 left to triage." onUndo={() => {}} />)
+    const status = screen.getByRole("status")
+    expect(status).toHaveTextContent("Fernhill Capital qualified.")
+    expect(status).toHaveTextContent("11 left to triage.")
+  })
+
+  it("calls onUndo once per click and is disabled while the reversal is in flight", async () => {
+    let finish!: () => void
+    const onUndo = vi.fn(() => new Promise<void>((r) => (finish = r)))
+    const user = userEvent.setup()
+    render(<UndoNotice message="Done." onUndo={onUndo} />)
+    await user.click(screen.getByRole("button", { name: "Undo" }))
+    const busy = screen.getByRole("button", { name: "Undoing…" })
+    expect(busy).toBeDisabled()
+    await user.click(busy)
+    expect(onUndo).toHaveBeenCalledTimes(1)
+    finish()
+    await waitFor(() => expect(screen.getByRole("button", { name: "Undo" })).toBeEnabled())
+  })
+
+  it.each([
+    ["rejects", () => Promise.reject(new Error("boom"))],
+    ["resolves false", () => Promise.resolve(false)],
+  ])("says nothing changed and keeps Undo available when the reversal %s", async (_n, onUndo) => {
+    const user = userEvent.setup()
+    render(<UndoNotice message="Done." detail="2 left." onUndo={onUndo} />)
+    await user.click(screen.getByRole("button", { name: "Undo" }))
+    expect(await screen.findByText("Couldn't undo. Nothing changed; try again.")).toBeVisible()
+    expect(screen.getByRole("button", { name: "Undo" })).toBeEnabled()
+  })
+
+  it("does not show a failure after a successful undo", async () => {
+    const user = userEvent.setup()
+    render(<UndoNotice message="Done." detail="2 left." onUndo={() => Promise.resolve(true)} />)
+    await user.click(screen.getByRole("button", { name: "Undo" }))
+    await waitFor(() => expect(screen.getByRole("button", { name: "Undo" })).toBeEnabled())
+    expect(screen.queryByText(/Couldn't undo/)).toBeNull()
+  })
+})
diff --git a/src/components/shared/undo-notice.tsx b/src/components/shared/undo-notice.tsx
new file mode 100644
index 0000000..a30dabf
--- /dev/null
+++ b/src/components/shared/undo-notice.tsx
@@ -0,0 +1,58 @@
+import * as React from "react"
+
+import { Alert, AlertAction, AlertDescription, AlertTitle } from "@/components/ui/alert"
+import { Button } from "@/components/ui/button"
+import { Icon } from "@/components/ui/icon"
+
+export interface UndoNoticeProps {
+  /** What changed, in the person's terms: "Fernhill Capital qualified and assigned to you." */
+  message: string
+  /** The consequence worth knowing now, e.g. "11 left to triage." Keep it true to the data on screen. */
+  detail?: React.ReactNode
+  /**
+   * Reverse the action and restore the exact prior state. May be async. Resolving to `false` or rejecting
+   * means nothing was undone: the notice says so and keeps Undo available.
+   */
+  onUndo: () => void | boolean | Promise<unknown>
+  className?: string
+}
+
+/**
+ * Confirms that an action changed a record and lets the person reverse it.
+ * Announced politely (role=status), stays until the caller replaces or removes it (it never auto-dismisses),
+ * and its Undo is disabled while the reversal is in flight so it cannot fire twice.
+ */
+export function UndoNotice({ message, detail, onUndo, className }: UndoNoticeProps) {
+  const [pending, setPending] = React.useState(false)
+  const [failed, setFailed] = React.useState(false)
+
+  async function undo() {
+    setPending(true)
+    setFailed(false)
+    try {
+      const result = await onUndo()
+      if (result === false) setFailed(true)
+    } catch {
+      setFailed(true)
+    } finally {
+      setPending(false)
+    }
+  }
+
+  return (
+    <Alert role="status" className={className}>
+      <Icon name="check" />
+      <AlertTitle>{message}</AlertTitle>
+      {(detail || failed) && (
+        <AlertDescription>
+          {failed ? "Couldn't undo. Nothing changed; try again." : detail}
+        </AlertDescription>
+      )}
+      <AlertAction>
+        <Button size="sm" variant="outline" disabled={pending} onClick={() => void undo()}>
+          {pending ? "Undoing…" : "Undo"}
+        </Button>
+      </AlertAction>
+    </Alert>
+  )
+}
